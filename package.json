{
  "name": "tnh-salon-backend",
  "version": "1.0.0",
  "description": "TNH Salon backend API (Admin authentication)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seedCatalog.mjs",
    "seed:admin": "node src/seed/adminSeeder.js",
    "admin:sync-credentials": "node scripts/updateAdminCredentials.mjs",
    "seed:catalog": "node scripts/seedCatalog.mjs",
    "backfill:subcategories": "node scripts/backfillServiceSubCategories.mjs",
    "backfill:subcategory-order": "node scripts/backfillSubCategoryOrder.mjs",
    "backfill:service-order": "node scripts/backfillServiceOrder.mjs",
    "media:prepare": "node scripts/migrateMediaToR2.mjs --prepare",
    "media:migrate": "node scripts/migrateMediaToR2.mjs --migrate",
    "media:rollback": "node scripts/migrateMediaToR2.mjs --rollback",
    "test": "node --test tests/*.test.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
