PORT=port_number_here

# Neon PostgreSQL connection string (Dashboard -> your project -> Connection Details).
# Keep the pooled ("-pooler") host for normal app traffic.
DATABASE_URL=neon_postgresql_connection_string_here

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=your_jwt_expiration_time_here
CLIENT_URL=frontend_url_here

ADMIN_NAME=TNH Admin
ADMIN_EMAIL=admin_email
ADMIN_PASSWORD=admin_password

# Cloudflare R2 migration target (server-side only; never add these to the frontend).
# R2_ACCOUNT_ID is used to construct the S3-compatible API endpoint.
# R2_PUBLIC_BASE_URL is the HTTPS public media domain, not the S3 API endpoint.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_BASE_URL=https://media.example.com